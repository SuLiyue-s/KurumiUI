{
  "name": "kurumi-ui",
  "version": "1.3.6",
  "private": true,
  "description": "KurumiUI —— 科技未来 + 动漫（时崎狂三）风格的配置驱动、可拆解 UI 框架",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "serve": "node server.js",
    "build:config": "node tools/build-config.js && node tools/build-all.js",
    "test": "node test/run.js",
    "test:node13": "\".tools/node-v13.14.0-win-x64/node.exe\" test/run.js",
    "smoke": "node tools/smoke.js",
    "check:assets": "node tools/check-assets.js",
    "check:compat": "node tools/check-compat.js",
    "check:manual": "node tools/check-manual.js",
    "shot": "node tools/screenshot.js",
    "verify:handlers": "node tools/verify-handlers-demo.js",
    "verify:bridge": "node tools/verify-dialog-bridge.js",
    "verify": "node tools/smoke.js && node tools/verify-handlers-demo.js && node tools/verify-dialog-bridge.js",
    "build:all": "node tools/build-all.js",
    "audit:consistency": "node tools/audit-consistency.js",
    "audit:components": "node tools/audit-components.js",
    "audit": "node tools/audit-consistency.js && node tools/audit-components.js",
    "build": "node tools/build-config.js && node tools/build-all.js"
  },
  "engines": {
    "node": ">=13.14.0"
  },
  "keywords": [
    "ui",
    "framework",
    "config-driven",
    "iframe",
    "theme",
    "kurumi"
  ],
  "license": "MIT"
}
