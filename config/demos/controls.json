                  "maxTagCount": 2,
                  "clearable": true,
                  "options": [
                    {
                      "label": "演算",
                      "value": "演算"
                    },
                    {
                      "label": "观测",
                      "value": "观测"
                    },
                    {
                      "label": "封印",
                      "value": "封印"
                    },
                    {
                      "label": "回溯",
                      "value": "回溯"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "field",
          "props": {
            "label": "checkbox · 单个勾选",
            "children": [
              {
                "type": "checkbox",
                "props": {
                  "text": "启用灵装回路",
                  "value": true
                }
              }
            ]
          }
        },
        {
          "type": "field",
          "props": {
            "label": "checkbox-group · 观测方式",
            "children": [
              {
                "type": "checkbox-group",
                "props": {
                  "value": [
                    "auto",
                    "alert"
                  ],
                  "options": [
                    {
                      "label": "自动观测",
                      "value": "auto"
                    },
                    {
                      "label": "人工复核",
                      "value": "manual"
                    },
                    {
                      "label": "定时回溯",
                      "value": "cron"
                    },
                    {
                      "label": "异常告警",
                      "value": "alert"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "field",
          "props": {
            "label": "radio · 单个单选",
            "children": [
              {
                "type": "radio",
                "props": {
                  "text": "默认选中此项",
                  "value": true
                }
              }
            ]
          }
        },
        {
          "type": "field",
          "props": {
            "label": "radio-group · 优先级",
            "children": [
              {
                "type": "radio-group",
                "props": {
                  "value": "normal",
                  "options": [
                    {
                      "label": "低",
                      "value": "low"
                    },
                    {
                      "label": "标准",
                      "value": "normal"
                    },
                    {
                      "label": "高",
                      "value": "high"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "field",
          "props": {
            "label": "switch · 开关",
            "children": [
              {
                "type": "switch",
                "props": {
                  "value": true,
                  "activeText": "开启",
                  "inactiveText": "关闭"
                }
              }
            ]
          }
        },
        {
          "type": "field",
          "props": {
            "label": "slider · 双端范围",
            "children": [
              {
                "type": "slider",
                "props": {
                  "range": true,
                  "value": [
                    20,
                    70
                  ],
                  "min": 0,
                  "max": 100,
                  "step": 5,
                  "showTooltip": true
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "date",
      "title": "日期与时间",
      "icon": "calendar",
      "desc": "date / daterange / time / datetime / month",
      "nodes": [
