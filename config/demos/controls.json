          "type": "field",
          "props": {
            "label": "select · 下拉选择",
            "children": [
              {
                "type": "select",
                "props": {
                  "placeholder": "选择时间模式",
                  "clearable": true,
                  "options": [
                    {
                      "label": "时间线",
                      "value": "timeline"
                    },
                    {
                      "label": "封印",
                      "value": "seal"
                    },
                    {
                      "label": "自定义",
                      "value": "custom"
                    },
                    {
                      "label": "归档（禁用）",
                      "value": "archived",
                      "disabled": true
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "field",
          "props": {
            "label": "multiselect · 战术标签",
            "children": [
              {
                "type": "multiselect",
                "props": {
                  "placeholder": "可多选",
                  "value": [
                    "演算",
                    "观测"
