        },
        {
          "type": "field",
          "props": {
            "label": "month · 月份",
            "children": [
              {
                "type": "month",
                "props": {
                  "format": "YYYY-MM",
                  "valueFormat": "YYYY-MM",
                  "clearable": true
                }
              }
            ]
          }
        }
      ]
    },
