        },
        {
          "type": "field",
          "props": {
            "label": "daterange · 日期范围",
            "children": [
              {
                "type": "daterange",
                "props": {
                  "startPlaceholder": "开始",
                  "endPlaceholder": "结束",
                  "separator": " ~ ",
                  "clearable": true
