{
  "title": "控件 · controls",
  "desc": "契约 §6 全部 33 种控件的陈列馆：字段即控件，controls 独立渲染可直接消费本文件。每个条目用 field 容器包裹，同时演示 field 自身的用法。",
  "groups": [
    {
      "id": "input",
      "title": "输入类",
      "icon": "edit",
      "desc": "input / password / textarea / number",
      "nodes": [
        {
          "type": "field",
          "props": {
            "label": "input · 文本输入",
            "help": "clearable + prefixIcon + maxlength",
            "children": [
              {
                "type": "input",
                "props": {
                  "placeholder": "输入灵装回路名称",
                  "clearable": true,
                  "prefixIcon": "feather",
                  "maxlength": 20
                }
              }
            ]
          }
        },
        {
          "type": "field",
          "props": {
            "label": "input · 带单位",
            "children": [
              {
                "type": "input",
                "props": {
                  "placeholder": "100",
                  "suffix": "秒",
                  "align": "right"
                }
              }
            ]
          }
        },
        {
          "type": "field",
          "props": {
            "label": "password · 灵装密钥",
            "children": [
              {
                "type": "password",
                "props": {
                  "placeholder": "输入密钥",
                  "toggleable": true,
                  "maxlength": 32
                }
              }
            ]
          }
        },
        {
          "type": "field",
          "props": {
            "label": "textarea · 备注",
            "children": [
              {
                "type": "textarea",
                "props": {
                  "placeholder": "记录这次时间跳跃的观测结果…",
                  "rows": 3,
                  "autosize": true,
                  "maxlength": 200,
                  "showCount": true
                }
              }
            ]
          }
        },
        {
          "type": "field",
          "props": {
            "label": "number · 子弹数量",
            "help": "min 1 / max 12 / step 1 / unit 发",
            "children": [
              {
                "type": "number",
                "props": {
                  "value": 3,
                  "min": 1,
                  "max": 12,
                  "step": 1,
                  "unit": "发",
                  "controls": true
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "choice",
      "title": "选择类",
      "icon": "list",
      "desc": "select / multiselect / checkbox / checkbox-group / radio / radio-group / switch / slider",
      "nodes": [
