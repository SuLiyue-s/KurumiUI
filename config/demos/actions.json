    {
      "id": "dialog",
      "title": "弹窗动作",
      "icon": "message",
      "desc": "dialog.* 与 KUI.dialog 同源，params 即 config 字段。",
      "actions": [
        {
          "type": "button",
          "props": {
            "text": "dialog.alert",
            "icon": "info",
            "size": "sm"
          },
          "on": {
            "click": {
              "action": "dialog.alert",
              "params": {
                "title": "结界通告",
                "message": "来自 JSON 的 alert：on.click.action = dialog.alert。"
              }
            }
          }
        },
        {
          "type": "button",
          "props": {
            "text": "dialog.confirm",
            "icon": "question",
            "size": "sm"
          },
          "on": {
            "click": {
              "action": "dialog.confirm",
              "params": {
                "title": "确认结界",
                "message": "来自 JSON 的 confirm，确定后仅关闭弹窗。"
              }
            }
          }
        },
        {
          "type": "button",
          "props": {
            "text": "dialog.prompt",
            "icon": "edit",
            "size": "sm"
          },
          "on": {
            "click": {
              "action": "dialog.prompt",
              "params": {
                "title": "命名结界",
                "label": "结界名称",
                "placeholder": "输入名称…",
                "defaultValue": "一之弹"
              }
            }
          }
        },
        {
          "type": "button",
          "props": {
            "text": "dialog.form",
            "icon": "settings",
            "size": "sm"
          },
          "on": {
            "click": {
              "action": "dialog.form",
              "params": {
                "title": "快捷配置",
                "data": {
                  "name": "刻刻帝",
                  "notify": true
                },
                "nodes": [
                  {
                    "id": "name",
                    "type": "input",
                    "label": "名称",
                    "required": true
                  },
                  {
                    "id": "notify",
                    "type": "switch",
                    "label": "提醒"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "button",
          "props": {
            "text": "dialog.custom",
            "icon": "code",
            "size": "sm"
          },
          "on": {
            "click": {
              "action": "dialog.custom",
              "params": {
                "title": "自定义弹窗",
                "nodes": [
                  {
                    "type": "alert",
                    "props": {
                      "type": "info",
                      "message": "custom 弹窗的 nodes 也来自 JSON。"
                    }
                  }
                ],
                "actions": [
                  {
                    "id": "ok",
                    "text": "知道了",
                    "type": "primary",
                    "close": "resolve",
                    "value": "ok"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "button",
          "props": {
            "text": "dialog.closeAll",
            "icon": "close",
            "variant": "ghost",
            "size": "sm"
          },
          "on": {
            "click": {
              "action": "dialog.closeAll"
            }
          }
        }
      ]
    },
    {
