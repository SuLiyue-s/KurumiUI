{
  "title": "动作 · actions",
  "desc": "全部内置动作的 JSON 侧写法：按钮节点的 on.click 只写动作名与 params，由 KUI.actions.run 统一分发。覆盖主题 / 导航 / 菜单 / 弹窗 / 提醒 / 剪贴板 / 标签 七类。",
  "groups": [
    {
      "id": "theme",
      "title": "主题动作",
      "icon": "palette",
      "desc": "theme.* 由 bootstrap 注册；theme.apply 的 params.id 即 src/themes.json 中的主题 id。",
      "actions": [
        {
          "type": "button",
          "props": {
            "text": "theme.picker",
            "icon": "palette",
            "variant": "primary",
            "size": "sm"
          },
          "on": {
            "click": {
              "action": "theme.picker"
            }
          }
        },
        {
          "type": "button",
          "props": {
            "text": "theme.apply 绯红",
            "icon": "moon",
            "size": "sm"
          },
          "on": {
            "click": {
              "action": "theme.apply",
              "params": {
                "id": "kurumi"
              }
            }
          }
        },
        {
          "type": "button",
          "props": {
            "text": "theme.apply 白羽",
            "icon": "sun",
            "size": "sm"
          },
          "on": {
            "click": {
              "action": "theme.apply",
              "params": {
                "id": "kurumi-angel"
              }
            }
          }
        },
        {
          "type": "button",
          "props": {
            "text": "theme.toggleScheme",
            "icon": "palette",
            "size": "sm"
          },
          "on": {
            "click": {
              "action": "theme.toggleScheme"
            }
          }
        },
        {
          "type": "button",
          "props": {
            "text": "theme.next",
            "icon": "chevron-right",
            "size": "sm"
          },
          "on": {
            "click": {
              "action": "theme.next"
            }
          }
        },
        {
          "type": "button",
          "props": {
            "text": "theme.prev",
            "icon": "chevron-left",
            "size": "sm"
          },
          "on": {
            "click": {
              "action": "theme.prev"
            }
          }
        }
      ]
    },
