  "fields": [
    {
      "name": "url",
      "type": "string",
      "desc": "头像图片地址（http(s) / 相对路径 / data:image）；空字符串表示未设置，显示 fallbackIcon。"
    },
    {
      "name": "editable",
      "type": "boolean",
      "desc": "渲染完成后是否允许点击头像更换（true 时点击打开 KUI.dialog.form 更换弹窗）。"
    },
    {
      "name": "persist",
      "type": "boolean",
      "desc": "用户更换后是否写入 localStorage（默认 false）。"
    },
    {
      "name": "size",
      "type": "number",
      "desc": "头像直径 px（默认 44）。"
    },
    {
      "name": "shape",
      "type": "string",
      "desc": "circle（默认）/ square。"
    },
    {
      "name": "fallbackIcon",
      "type": "string",
      "desc": "未设置头像时的图标名（默认 clock，可换 user / feather / crown 等）。"
    },
    {
      "name": "frame.enabled",
      "type": "boolean",
      "desc": "设置头像后是否绘制刻刻帝时间齿轮框（默认 true）。"
    },
    {
      "name": "frame.showTicks",
      "type": "boolean",
      "desc": "是否显示 12 道时间刻线（默认 true）。"
    },
    {
      "name": "frame.showRoman",
      "type": "boolean",
      "desc": "是否显示罗马数字刻度（默认 false）。"
    },
    {
      "name": "frame.showHands",
      "type": "boolean",
      "desc": "是否显示时针分针与轴心宝石（默认 true）。"
    },
    {
      "name": "frame.animated",
      "type": "boolean",
      "desc": "齿轮是否缓慢旋转（默认 true）。"
    },
    {
      "name": "picker.*",
      "type": "object",
      "desc": "更换弹窗文案：title / urlLabel / urlPlaceholder / urlTip / clearLabel / presets 等。"
    }
  ]
}
